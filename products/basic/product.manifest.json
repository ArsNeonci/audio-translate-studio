{
  "product_id": "audio-translate-basic",
  "name": "Audio Translate Basic",
  "platform": "windows",
  "version": "3.1.0",
  "build_adapter": "audio-translate",
  "license_scheme": "ed25519-v1",
  "repo_root": "../..",
