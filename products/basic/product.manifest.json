    "python",
    "packaging/build_installer.py",
    "--product",
    "audio-translate-basic"
  ],
  "artifact_path": "dist/AudioTranslate-Basic-3.1.0.exe",
  "gateway": {
    "app_id": "audio-translates",
    "app_name": "Audio Translate",
    "services": [
      "translation",
      "tts"
    ]
  }
}
