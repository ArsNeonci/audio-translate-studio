# Copy to .env.local. The app automatically uses .venv when available.
# Persisted final outputs; relative paths resolve from the project directory.
# Default is data/results/ (or AUDIO_DATA_DIR/results in isolated tests).
# RESULTS_ROOT=data/results
# Optional override (use forward slashes for Windows paths):
# PYTHON_BIN=C:/Workspace/Audio-translate/audio-translates/.venv/Scripts/python.exe

# Only configure when YouTube asks for authentication.
# Export youtube.com cookies in Netscape format; keep this file on your machine.
# YTDLP_COOKIES_FILE=data/private/youtube-cookies.txt
# Settings → Kết nối YouTube manages a separate Edge/Chrome profile per Windows user.
# Default: %LOCALAPPDATA%/AudioTranslate/youtube (outside the install/repo directory).
# Connected profile takes priority over YTDLP_COOKIES_FILE. Do not package either.
# Optional overrides for nonstandard browser locations / isolated tests:
# YOUTUBE_BROWSER_BIN=C:/Program Files (x86)/Microsoft/Edge/Application/msedge.exe
# YOUTUBE_SESSION_ROOT=C:/Users/YourUser/AppData/Local/AudioTranslate/youtube

# CPU is the default. CUDA requires a compatible PyTorch installation.
# FUNASR_DEVICE=cuda:0
# CPU: auto calibrates 4/6/8 threads once per hardware/model version (7-day cache).
ASR_CPU_MODE=auto
ASR_MAX_WORKERS=2
ASR_CPU_TARGET=85
# Manual still obeys RAM/CPU admission and available physical core limits.
# ASR_CPU_MODE=manual
# ASR_CPU_THREADS=6
# ASR_CPU_WORKERS=2
# ASR_TEMP_LIMIT=85

# The adapter detects the existing sibling Hugging Face NLLB snapshot by default.
# Otherwise it downloads the official facebook/nllb-200-distilled-600M model.
# NLLB_MODEL_PATH=C:/models/nllb-200-distilled-600M
NLLB_DEVICE=cpu
NLLB_BATCH_SIZE=4

# Path to the unchanged VieNeu repo (the directory containing src/).
# VIENEU_SOURCE=C:/Workspace/Audio-translate/VieNeu-TTS-main
VIENEU_DEVICE=cpu
VIENEU_VOICE=Hải Đăng
VIENEU_PRECISION=fp32
AI_NUM_THREADS=4

# Optional: isolate data/build for integration tests; normal runs use data/ and .next/.
# AUDIO_DATA_DIR=C:/Workspace/Audio-translate/audio-translates/data/verification/acceptance
# AUDIO_NEXT_DIST_DIR=.next-verification
