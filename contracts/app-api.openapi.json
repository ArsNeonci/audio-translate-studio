{
  "openapi": "3.1.0",
  "info": {
    "title": "Audio Translate app API",
    "version": "1.2.0-g1",
    "description": "The local HTTP API the app UI calls (today served by Next.js route handlers under app/api, from G4 by the FastAPI sidecar). It describes the behaviour of the code at tag rearch-g0 as observed by contracts/tests/run_app_contract.py, including error codes. Conventions: x-no-store marks responses sent with 'Cache-Control: no-store'; x-licensed marks operations that answer 403 LicenseDenied when the licence is not ACTIVE; x-origin marks operations that answer 403 'Origin rejected' to a browser page from another site; x-local marks operations that also require a loopback host and refuse cross-site fetches; x-untested on a response gives the reason the contract test cannot produce it."
  },
  "servers": [{"url": "http://127.0.0.1:{port}", "variables": {"port": {"default": "3000"}}}],
  "paths": {
    "/api/billing": {
      "get": {"summary": "Customer Code and whether the Billing portal can be opened", "responses": {
        "200": {"x-no-store": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/BillingInfo"}}}}}},
      "post": {"summary": "Make the address of the Billing portal (one-time link, Customer Code or home page)", "x-origin": true,
        "requestBody": {"content": {"application/json": {"schema": {"type": "object", "properties": {"destination": {"enum": ["license", "debt"]}}}}}},
        "responses": {
          "200": {"x-no-store": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/PortalLink"}}}},
          "403": {"description": "Origin rejected", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
          "502": {"x-no-store": true, "x-untested": "needs a gateway that refuses", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CodeError"}}}}}}
    },
    "/api/history": {
      "get": {"summary": "Saved workflows, filtered and paged", "parameters": [
          {"name": "search", "in": "query", "schema": {"type": "string"}},
          {"name": "status", "in": "query", "schema": {"type": "string"}},
          {"name": "sort", "in": "query", "schema": {"enum": ["newest", "oldest"]}},
          {"name": "page", "in": "query", "schema": {"type": "integer", "minimum": 1}},
          {"name": "limit", "in": "query", "schema": {"type": "integer", "minimum": 1, "maximum": 100}}],
        "responses": {
          "200": {"x-no-store": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HistoryPage"}}}},
          "503": {"x-untested": "needs a broken worker", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}}}
    },
    "/api/history/{id}": {
      "get": {"summary": "One saved workflow with its files", "responses": {
        "200": {"x-no-store": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HistoryJobEnvelope"}}}},
        "404": {"x-no-store": true, "description": "Unknown id or not a UUID", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
        "503": {"x-untested": "needs a broken worker", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}}},
      "delete": {"summary": "Delete a saved workflow (body {\"confirm\": <workflow_no>})", "responses": {
        "200": {"x-no-store": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Deleted"}}}},
        "400": {"description": "Invalid JSON (no Cache-Control)", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
        "404": {"x-no-store": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}}}
    },
    "/api/history/{id}/files/{fileId}": {
      "get": {"summary": "A saved file inline; ?preview=1 returns a bounded text page. Licensed unless downloading.", "x-licensed": true, "responses": {
        "200": {"x-untested": "inline reads need an ACTIVE licence", "content": {"application/octet-stream": {}}},
        "403": {"x-no-store": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/LicenseDenied"}}}},
        "404": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}}}
    },
    "/api/history/{id}/files/{fileId}/download": {
      "get": {"summary": "A saved file as an attachment. Supports Range and ?preview=1&offset=N.", "responses": {
        "200": {"x-no-store": true, "description": "The file, or a FilePreview with ?preview=1", "content": {"application/octet-stream": {}, "application/json": {"schema": {"$ref": "#/components/schemas/FilePreview"}}}},
        "206": {"x-no-store": true, "description": "Range request", "content": {"application/octet-stream": {}}},
        "400": {"description": "Invalid preview offset", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
        "404": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
        "416": {"description": "Unsatisfiable range; Content-Range: bytes */<size>"}}}
    },
    "/api/jobs": {
      "get": {"summary": "Current workflows (also runs the scheduler)", "responses": {
        "200": {"x-no-store": true, "content": {"application/json": {"schema": {"type": "object", "required": ["jobs"], "properties": {"jobs": {"type": "array", "items": {"$ref": "#/components/schemas/Job"}}}}}}}}},
      "post": {"summary": "Create a workflow from a YouTube link (JSON) or an uploaded audio file (raw body, ?name=...)", "x-licensed": true, "responses": {
        "201": {"x-no-store": true, "x-untested": "needs an ACTIVE licence", "content": {"application/json": {"schema": {"type": "object", "required": ["job"]}}}},
        "400": {"x-untested": "validation runs after the licence gate", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
        "403": {"x-no-store": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/LicenseDenied"}}}},
        "413": {"x-untested": "needs a licence and a 2 GB upload", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
        "503": {"x-untested": "needs a licence and a broken worker", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}}}
    },
    "/api/jobs/preflight": {
      "get": {"summary": "Can another workflow start now (resources)", "x-licensed": true, "responses": {
        "200": {"x-untested": "needs an ACTIVE licence", "content": {"application/json": {"schema": {"type": "object"}}}},
        "403": {"x-no-store": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/LicenseDenied"}}}}}}
    },
    "/api/jobs/{id}": {
      "get": {"summary": "One current workflow", "responses": {
        "200": {"x-no-store": true, "content": {"application/json": {"schema": {"type": "object", "required": ["job"], "properties": {"job": {"$ref": "#/components/schemas/Job"}}}}}},
        "404": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}}}
    },
    "/api/jobs/{id}/abort": {
      "post": {"summary": "Stop and delete a workflow (body {\"confirm\": <workflow_no>})", "responses": {
        "200": {"x-no-store": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Deleted"}}}},
        "400": {"description": "Invalid JSON", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
        "409": {"x-no-store": true, "description": "Confirmation number or scope does not match", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
        "404": {"x-no-store": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}}}
    },
    "/api/jobs/{id}/artifacts/{kind}": {
      "get": {"summary": "An output by kind (source, zh, vi, moderated, voice); ?format=jsonl, ?download=1, ?preview=1. Licensed unless downloading.", "x-licensed": true, "responses": {
        "200": {"x-no-store": true, "content": {"text/markdown": {}, "audio/wav": {}}},
        "403": {"x-no-store": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/LicenseDenied"}}}},
        "404": {"description": "Unknown kind or output not ready", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
        "503": {"x-untested": "needs a broken worker", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}}}
    },
    "/api/jobs/{id}/cancel": {
      "post": {"summary": "Cancel a running or queued workflow", "responses": {
        "200": {"x-no-store": true, "content": {"application/json": {"schema": {"type": "object"}}}},
        "409": {"x-no-store": true, "description": "Run is already stopped", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
        "404": {"x-no-store": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}}}
    },
    "/api/jobs/{id}/characters": {
      "get": {"summary": "The character sheet used for forms of address", "responses": {
        "200": {"x-no-store": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CharacterSheetEnvelope"}}}},
        "404": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}}},
      "put": {"summary": "Replace the character sheet (stopped workflows only)", "responses": {
        "200": {"x-no-store": true, "content": {"application/json": {"schema": {"type": "object", "required": ["sheet"], "properties": {"sheet": {"$ref": "#/components/schemas/CharacterSheet"}}}}}},
        "400": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
        "404": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
        "409": {"description": "The workflow is running", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
        "413": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}}}
    },
    "/api/jobs/{id}/errors": {
      "get": {"summary": "Recorded errors of a workflow", "responses": {
        "200": {"x-no-store": true, "content": {"application/json": {"schema": {"type": "object", "required": ["errors"], "properties": {"errors": {"type": "array"}}}}}},
        "404": {"x-no-store": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
        "503": {"x-untested": "needs a broken worker", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}}}
    },
    "/api/jobs/{id}/pause": {
      "post": {"summary": "Pause a running or queued workflow", "responses": {
        "200": {"x-no-store": true, "content": {"application/json": {"schema": {"type": "object"}}}},
        "409": {"x-no-store": true, "description": "Run is already stopped", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
        "404": {"x-no-store": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}}}
    },
    "/api/jobs/{id}/reprocess": {
      "post": {"summary": "Run again from a step (body {step, voice?, style?, address?, mode?})", "x-licensed": true, "responses": {
        "200": {"x-untested": "needs an ACTIVE licence", "content": {"application/json": {"schema": {"type": "object", "required": ["job"]}}}},
        "403": {"x-no-store": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/LicenseDenied"}}}}}}
    },
    "/api/jobs/{id}/resume": {
      "post": {"summary": "Continue a paused workflow", "x-licensed": true, "responses": {
        "200": {"x-untested": "needs an ACTIVE licence", "content": {"application/json": {"schema": {"type": "object", "required": ["job"]}}}},
        "403": {"x-no-store": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/LicenseDenied"}}}}}}
    },
    "/api/jobs/{id}/retry": {
      "post": {"summary": "Retry a failed workflow", "x-licensed": true, "responses": {
        "200": {"x-untested": "needs an ACTIVE licence", "content": {"application/json": {"schema": {"type": "object", "required": ["job"]}}}},
        "403": {"x-no-store": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/LicenseDenied"}}}},
        "409": {"x-untested": "needs an ACTIVE licence", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}}}
    },
    "/api/jobs/{id}/review": {
      "post": {"summary": "Basic: continue to paid voice or finish without it (body {decision})", "x-licensed": true, "responses": {
        "200": {"x-untested": "needs an ACTIVE licence", "content": {"application/json": {"schema": {"type": "object", "required": ["job"]}}}},
        "403": {"x-no-store": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/LicenseDenied"}}}}}}
    },
    "/api/jobs/{id}/steps/{step}": {
      "get": {"summary": "Fix guide for a failed step", "responses": {
        "200": {"x-no-store": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/StepGuide"}}}},
        "409": {"x-no-store": true, "description": "Unknown step", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
        "404": {"x-no-store": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}}},
      "post": {"summary": "Retry one step", "x-licensed": true, "responses": {
        "202": {"x-untested": "needs an ACTIVE licence", "content": {"application/json": {"schema": {"type": "object"}}}},
        "403": {"x-no-store": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/LicenseDenied"}}}}}}
    },
    "/api/jobs/{id}/transcript": {
      "get": {"summary": "Same as artifacts/zh", "x-licensed": true, "responses": {
        "200": {"x-no-store": true, "content": {"text/markdown": {}}},
        "403": {"x-no-store": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/LicenseDenied"}}}},
        "404": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}}}
    },
    "/api/license/lease": {
      "post": {"summary": "Check again: ask the gateway for a new lease now (after going online) and return the licence status", "x-origin": true, "responses": {
        "200": {"x-no-store": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/LicenseStatus"}}}},
        "403": {"description": "Origin rejected", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}}}},
    "/api/license": {
      "get": {"summary": "Licence status (?machine=1: the Machine ID). Also renews the lease in the background when due.", "responses": {
        "200": {"x-no-store": true, "content": {"application/json": {"schema": {"anyOf": [{"$ref": "#/components/schemas/LicenseStatus"}, {"$ref": "#/components/schemas/MachineId"}]}}}}}},
      "post": {"summary": "Activate or renew with a token (body {action: activate|renew, token})", "x-origin": true, "responses": {
        "200": {"x-no-store": true, "x-untested": "needs a valid token for this machine", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/LicenseCommandResult"}}}},
        "400": {"description": "Invalid request or token too long", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
        "403": {"description": "Origin rejected, or the core refused the token (LicenseCommandResult with status INVALID)", "content": {"application/json": {"schema": {"anyOf": [{"$ref": "#/components/schemas/LicenseCommandResult"}, {"$ref": "#/components/schemas/Error"}]}}}}}}
    },
    "/api/model": {
      "get": {"summary": "State of the offline translation model", "responses": {
        "200": {"x-no-store": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ModelState"}}}}}},
      "post": {"summary": "Start or resume the model download", "x-origin": true, "responses": {
        "200": {"x-no-store": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ModelState"}}}},
        "403": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}}}
    },
    "/api/update": {
      "get": {"summary": "App updates: the installed version, the release on offer (if newer), the download, and how the last update ended. Asking also starts a check in the background when one is due.", "responses": {
        "200": {"x-no-store": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/UpdateState"}}}}}}
    },
    "/api/update/check": {
      "post": {"summary": "Ask the gateway for the newest release now (the Settings button); returns the new state", "x-local": true, "responses": {
        "200": {"x-no-store": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/UpdateState"}}}},
        "403": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}}}
    },
    "/api/update/download": {
      "post": {"summary": "Download and check the package of the release on offer in the background", "x-local": true, "responses": {
        "200": {"x-no-store": true, "content": {"application/json": {"schema": {"allOf": [{"$ref": "#/components/schemas/UpdateState"}, {"type": "object", "required": ["started"], "properties": {"started": {"type": "boolean"}}}]}}}},
        "403": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}}}
    },
    "/api/update/apply": {
      "post": {"summary": "Install the downloaded release: the app quits and updater.exe applies it (body {force?}); with workflows running it needs force", "x-local": true, "responses": {
        "200": {"x-no-store": true, "x-untested": "ends the app", "content": {"application/json": {"schema": {"type": "object", "required": ["applying"], "properties": {"applying": {"type": "boolean"}, "version": {"type": "string"}, "kind": {"enum": ["app", "installer"]}}}}}},
        "403": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
        "409": {"description": "NOT_INSTALLED (a development checkout), NOT_READY, or JOBS_RUNNING (retry with force)", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
        "500": {"x-untested": "needs an unwritable data folder", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}}}
    },
    "/api/update/ack": {
      "post": {"summary": "The person has seen how the last update ended", "x-local": true, "responses": {
        "200": {"x-no-store": true, "content": {"application/json": {"schema": {"type": "object", "required": ["ok"], "properties": {"ok": {"type": "boolean"}}}}}},
        "403": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}}}
    },
    "/api/quit": {
      "get": {"summary": "Whether Quit is available and how many workflows run", "responses": {
        "200": {"x-no-store": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/QuitInfo"}}}}}},
      "post": {"summary": "Stop the installed app (body {force?}); a development checkout answers stopped=false", "x-origin": true, "responses": {
        "200": {"x-no-store": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/QuitResult"}}}},
        "403": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}}}
    },
    "/api/rules": {
      "get": {"summary": "Replacement rules", "responses": {
        "200": {"x-no-store": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Rules"}}}},
        "500": {"x-untested": "needs a broken worker", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}}},
      "post": {"summary": "Add a rule (body {source, replacement})", "responses": {
        "200": {"x-no-store": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Rules"}}}},
        "400": {"description": "Invalid JSON, not an object, too long, empty source or duplicate", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}}}
    },
    "/api/rules/{id}": {
      "put": {"summary": "Edit a rule", "responses": {
        "200": {"x-no-store": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Rules"}}}},
        "400": {"description": "Invalid input or unknown rule", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}}},
      "delete": {"summary": "Delete a rule", "responses": {
        "200": {"x-no-store": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Rules"}}}},
        "400": {"x-no-store": true, "description": "Unknown rule", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}}}
    },
    "/api/settings/compute": {
      "get": {"summary": "CPU or GPU for new workflows", "x-local": true, "responses": {
        "200": {"x-no-store": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ComputeSettings"}}}},
        "403": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}}},
      "post": {"summary": "Choose cpu or gpu (JSON {device})", "x-local": true, "responses": {
        "200": {"x-no-store": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ComputeSettings"}}}},
        "400": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
        "403": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
        "415": {"description": "Not JSON", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}}}
    },
    "/api/settings/translation-memory": {
      "get": {"summary": "The free RAM a translation waits for before it starts, with its limits and the RAM free now", "x-local": true, "responses": {
        "200": {"x-no-store": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/TranslationMemory"}}}},
        "403": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}}},
      "post": {"summary": "Set it (JSON {start_free_gib}: 4 to 8 GiB in steps of 0.5). A workflow that is already waiting follows the new value at once.", "x-local": true, "responses": {
        "200": {"x-no-store": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/TranslationMemory"}}}},
        "400": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
        "403": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
        "415": {"description": "Not JSON", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}}}
    },
    "/api/video/pick": {
      "post": {"summary": "Video merge: show the Windows Open dialog (several files) and return the chosen clips, checked", "x-local": true, "responses": {
        "200": {"x-no-store": true, "x-untested": "opens a dialog on the desktop", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/VideoFiles"}}}},
        "403": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
        "409": {"description": "A dialog is already open", "x-untested": "needs a dialog left open", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
        "503": {"description": "The dialog failed", "x-untested": "needs a broken shell dialog", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}}}
    },
    "/api/video/check": {
      "post": {"summary": "Check chosen clips again (JSON {paths}): moved, deleted or changed since they were chosen", "x-local": true, "responses": {
        "200": {"x-no-store": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/VideoFiles"}}}},
        "400": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
        "403": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
        "415": {"description": "Not JSON", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}}}
    },
    "/api/video/estimate": {
      "post": {"summary": "Size estimate and disk check (JSON {paths, resolution, quality, voice_job?, burn?}); without a voice the size is per hour; burn (subtitles drawn into the picture) forces the re-encode and adds seconds_per_voice_second to the plan", "x-local": true, "responses": {
        "200": {"x-no-store": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/VideoEstimate"}}}},
        "400": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
        "403": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}}}
    },
    "/api/video/voices": {
      "get": {"summary": "Finished voices made by this app (workflows and tool 4) that tool 5 can lay over videos", "responses": {
        "200": {"x-no-store": true, "content": {"application/json": {"schema": {"type": "object", "required": ["voices"], "properties": {"voices": {"type": "array", "items": {
          "type": "object", "required": ["job_id", "scope", "name"], "properties": {"job_id": {"type": "string"}, "scope": {"enum": ["workflows", "tools"]},
          "workflow_no": {"type": ["integer", "null"]}, "name": {"type": "string"}, "created_at": {"type": "string"}, "video": {"type": "boolean"}}}}}}}}}}}
    },
    "/api/video/open": {
      "post": {"summary": "Open the finished video in the default player, or its folder (JSON {id, scope, target: video|folder})", "x-local": true, "responses": {
        "200": {"x-no-store": true, "x-untested": "opens a player on the desktop", "content": {"application/json": {"schema": {"type": "object", "required": ["opened"], "properties": {"opened": {"type": "boolean"}}}}}},
        "400": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
        "403": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
        "404": {"description": "No finished video for this run", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}}}
    },
    "/api/video/auto-open": {
      "post": {"summary": "Open, once, the videos that finished while the app window is open (the page calls it every few seconds)", "x-local": true, "responses": {
        "200": {"x-no-store": true, "content": {"application/json": {"schema": {"type": "object", "required": ["opened"], "properties": {"opened": {"type": "array", "items": {"type": "string"}}}}}}},
        "403": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}}}
    },
    "/api/settings/youtube": {
      "get": {"summary": "The saved YouTube session (this reads the real per-user profile, not the data folder)", "x-local": true, "responses": {
        "200": {"x-no-store": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/YoutubeStatus"}}}},
        "403": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}}},
      "post": {"summary": "open | check | disconnect | close_browser. Only refusals are tested: valid actions change the real YouTube session.", "x-local": true, "responses": {
        "200": {"x-untested": "would change the real YouTube session", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/YoutubeStatus"}}}},
        "400": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
        "403": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
        "415": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}}}
    },
    "/api/tools": {
      "get": {"summary": "Tool runs, filtered and paged like History", "responses": {
        "200": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/HistoryPage"}}}}}},
      "post": {"summary": "Start a tool: JSON {tool: transcription, url} or a raw upload with ?tool=&name=", "x-licensed": true, "responses": {
        "201": {"x-untested": "needs an ACTIVE licence", "content": {"application/json": {"schema": {"type": "object", "required": ["job"]}}}},
        "403": {"x-no-store": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/LicenseDenied"}}}}}}
    },
    "/api/tools/{id}": {
      "get": {"summary": "One tool run", "responses": {
        "200": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/HistoryJobEnvelope"}}}},
        "404": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}}},
      "delete": {"summary": "Delete a tool run (body {\"confirm\": <workflow_no>, \"scope\": \"tools\"} while it runs)", "responses": {
        "200": {"x-no-store": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Deleted"}}}},
        "400": {"description": "Invalid JSON", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
        "409": {"x-no-store": true, "description": "Confirmation number or scope does not match", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
        "404": {"x-no-store": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}}}
    },
    "/api/tools/{id}/files/{fileId}": {
      "get": {"summary": "A tool output; ?download=1 as an attachment", "x-licensed": true, "responses": {
        "200": {"x-no-store": true, "x-untested": "the seeded tool run has no output yet", "content": {"application/octet-stream": {}}},
        "404": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}}}
    },
    "/api/tools/{id}/review": {
      "post": {"summary": "Basic: continue or finish a tool run held before voice", "x-licensed": true, "responses": {
        "200": {"x-untested": "needs an ACTIVE licence", "content": {"application/json": {"schema": {"type": "object"}}}},
        "403": {"x-no-store": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/LicenseDenied"}}}}}}
    },
    "/api/voices": {
      "get": {"summary": "Voices, voice styles and address profiles", "responses": {
        "200": {"x-no-store": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Voices"}}}}}}
    },
    "/api/voices/preview/{key}": {
      "get": {"summary": "A pre-built voice sample (key: 64 hex)", "responses": {
        "200": {"description": "Samples ship pre-built in public/voice-previews; Cache-Control: public, max-age=31536000, immutable", "content": {"audio/wav": {}}},
        "404": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}}}
    }
  },
  "components": {
    "schemas": {
      "Error": {"type": "object", "required": ["error"], "properties": {"error": {"type": "string", "minLength": 1}}},
      "CodeError": {"type": "object", "required": ["error"], "properties": {"error": {"type": "string", "pattern": "^[A-Z_0-9]{3,60}$"}}},
      "LicenseDenied": {"type": "object", "required": ["error", "license_status"], "properties": {"error": {"type": "string"}, "license_status": {"type": "string", "pattern": "^[A-Z_]+$"}}},
      "Uuid": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
      "Timestamp": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T"},
      "JobStatus": {"type": "string", "pattern": "^[A-Z_]+$"},
      "StepName": {"enum": ["DOWNLOAD", "TRANSCRIPTION", "TRANSLATION", "MODERATION", "TTS", "SUBTITLE", "VIDEO"]},
      "StepState": {"type": "object", "required": ["state"], "properties": {"state": {"type": "string", "pattern": "^[A-Z_]+$"}, "progress": {"type": ["integer", "number"]}, "retry_count": {"type": "integer"}, "attempt": {"type": "integer"}}},
      "Steps": {"type": "object", "required": ["DOWNLOAD", "TRANSCRIPTION", "TRANSLATION", "MODERATION", "TTS"], "additionalProperties": {"$ref": "#/components/schemas/StepState"}},
      "Artifacts": {"type": "object", "required": ["source", "zh", "vi", "moderated", "voice"], "additionalProperties": {"type": "boolean"}},
      "Job": {"type": "object",
        "required": ["id", "workflow_no", "storage_scope", "url", "name", "status", "progress", "created_at", "steps", "artifacts", "delete_requested", "pause_requested", "transcription_steps"],
        "properties": {"id": {"$ref": "#/components/schemas/Uuid"}, "workflow_no": {"type": "integer", "minimum": 1}, "storage_scope": {"enum": ["workflows", "tools"]},
          "url": {"type": "string"}, "name": {"type": "string"}, "status": {"$ref": "#/components/schemas/JobStatus"}, "progress": {"type": ["integer", "number"]},
          "duration_ms": {"type": ["integer", "null"]}, "total_duration_ms": {"type": ["integer", "null"]}, "created_at": {"$ref": "#/components/schemas/Timestamp"},
          "error": {"type": ["string", "object", "null"]}, "workflow_version": {"type": "integer"}, "selected_voice_id": {"type": ["string", "null"]},
          "selected_voice_style": {"type": ["string", "null"]}, "selected_address_profile": {"type": ["string", "null"]},
          "steps": {"$ref": "#/components/schemas/Steps"}, "artifacts": {"$ref": "#/components/schemas/Artifacts"},
          "delete_requested": {"type": "boolean"}, "pause_requested": {"type": "boolean"},
          "transcription_steps": {"type": "array", "items": {"$ref": "#/components/schemas/StepState"}}}},
      "HistoryFile": {"type": "object", "required": ["id", "step", "type", "path", "size", "status", "created_at"],
        "properties": {"id": {"type": "string", "pattern": "^[A-Z_]+$"}, "step": {"$ref": "#/components/schemas/StepName"}, "type": {"type": "string"},
          "path": {"type": "string"}, "size": {"type": "integer", "minimum": 0}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "status": {"enum": ["AVAILABLE", "STALE", "PUBLISHING"]}, "created_at": {"$ref": "#/components/schemas/Timestamp"}}},
      "HistoryJob": {"type": "object",
        "required": ["id", "workflow_no", "storage_scope", "name", "url", "created_at", "status", "steps", "files", "delete_requested", "pause_requested"],
        "properties": {"id": {"$ref": "#/components/schemas/Uuid"}, "workflow_no": {"type": "integer", "minimum": 1}, "storage_scope": {"enum": ["workflows", "tools"]},
          "tool_type": {"type": ["string", "null"]}, "input_file": {"type": ["string", "null"]}, "name": {"type": "string"}, "url": {"type": "string"},
          "created_at": {"$ref": "#/components/schemas/Timestamp"}, "status": {"$ref": "#/components/schemas/JobStatus"},
          "tool_steps": {"type": ["array", "null"], "items": {"$ref": "#/components/schemas/StepName"}},
          "steps": {"$ref": "#/components/schemas/Steps"}, "files": {"type": "array", "items": {"$ref": "#/components/schemas/HistoryFile"}},
          "delete_requested": {"type": "boolean"}, "pause_requested": {"type": "boolean"}}},
      "HistoryJobEnvelope": {"type": "object", "required": ["job"], "properties": {"job": {"$ref": "#/components/schemas/HistoryJob"}}},
      "HistoryPage": {"type": "object", "required": ["jobs", "total", "page", "limit", "statuses"],
        "properties": {"jobs": {"type": "array", "items": {"$ref": "#/components/schemas/HistoryJob"}}, "total": {"type": "integer", "minimum": 0},
          "page": {"type": "integer", "minimum": 1}, "limit": {"type": "integer", "minimum": 1}, "statuses": {"type": "array", "items": {"$ref": "#/components/schemas/JobStatus"}}}},
      "FilePreview": {"type": "object", "required": ["content", "offset", "next_offset", "size"],
        "properties": {"content": {"type": "string"}, "offset": {"type": "integer", "minimum": 0}, "next_offset": {"type": ["integer", "null"]}, "size": {"type": "integer", "minimum": 0}}},
      "Deleted": {"type": "object", "properties": {"deleted": {"type": "boolean"}, "deletion_pending": {"type": "boolean"}}},
      "CharacterSheet": {"type": "object", "required": ["version", "characters"], "properties": {"version": {"type": "integer"}, "characters": {"type": "array"}}},
      "CharacterSheetEnvelope": {"type": "object", "required": ["sheet", "editable"], "properties": {"sheet": {"anyOf": [{"$ref": "#/components/schemas/CharacterSheet"}, {"type": "null"}]}, "editable": {"type": "boolean"}}},
      "StepGuide": {"type": "object", "required": ["error", "fix_guide"], "properties": {"error": {"type": ["string", "object", "null"]}, "fix_guide": {"type": ["string", "object", "array", "null"]}}},
      "LicenseStatus": {"type": "object", "required": ["http_status", "product_id", "status", "edition"],
        "properties": {"http_status": {"type": "integer"}, "product_id": {"type": "string"}, "status": {"type": "string", "pattern": "^[A-Z_]+$"}, "edition": {"enum": ["basic", "plus"]},
          "expires_at": {"type": "string"}, "sequence": {"type": "integer"}, "allowed": {"type": "boolean"},
          "lease": {"type": ["string", "null"], "description": "Lease phase (VALID, GRACE, EXPIRED, NONE, REVOKED), null when the service cannot say; only when status is ACTIVE"},
          "perpetual": {"type": "boolean", "description": "The licence never ends (expiry year 2100 or later): nothing to renew"},
          "renewal": {"type": "object", "description": "Only from POST /api/license/lease: the outcome of the lease request"}}},
      "MachineId": {"type": "object", "required": ["http_status", "machine_id", "product_id", "edition"],
        "properties": {"http_status": {"type": "integer"}, "machine_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "product_id": {"type": "string"}, "edition": {"enum": ["basic", "plus"]}}},
      "LicenseCommandResult": {"type": "object", "required": ["http_status", "status"],
        "properties": {"http_status": {"type": "integer"}, "status": {"type": "string", "pattern": "^[A-Z_]+$"}, "product_id": {"type": "string"}, "error": {"type": "string"}}},
      "ModelState": {"type": "object", "required": ["phase", "done", "total"],
        "properties": {"phase": {"type": "string"}, "done": {"type": "integer", "minimum": 0}, "total": {"type": "integer", "minimum": 0}, "license": {"type": "string"}, "error": {"type": "string"}}},
      "BillingInfo": {"type": "object", "required": ["enabled"], "properties": {"enabled": {"type": "boolean"}, "code": {"type": "string"}, "portal_url": {"type": "string"}}},
      "PortalLink": {"type": "object", "required": ["url", "mode"], "properties": {"url": {"type": "string", "pattern": "^https://"}, "mode": {"enum": ["app", "code", "home"]}}},
      "UpdateState": {"type": "object", "required": ["installed", "channel", "offer", "download", "ready", "checked_at", "error", "last_result"], "properties": {
        "installed": {"type": "object", "required": ["version", "product", "runtime", "can_update"], "properties": {"version": {"type": ["string", "null"]}, "product": {"type": ["string", "null"]}, "runtime": {"type": ["string", "null"]}, "can_update": {"type": "boolean"}}},
        "channel": {"type": "string"},
        "offer": {"type": ["object", "null"], "properties": {"version": {"type": "string"}, "serial": {"type": "integer"}, "notes": {"type": "object"}, "released_at": {"type": "string"}, "kind": {"enum": ["app", "installer"]}, "size": {"type": "integer"}, "required": {"type": "boolean"}, "failed_before": {"type": "boolean"}, "downgrade": {"type": "boolean"}}},
        "download": {"type": "object", "required": ["state", "done", "total"], "properties": {"state": {"enum": ["idle", "downloading", "ready", "failed"]}, "done": {"type": "integer"}, "total": {"type": "integer"}, "error": {"type": ["string", "null"]}, "version": {"type": ["string", "null"]}}},
        "ready": {"type": "boolean"}, "checked_at": {"type": ["number", "null"]}, "error": {"type": ["string", "null"]},
        "last_result": {"type": ["object", "null"], "properties": {"ok": {"type": "boolean"}, "version": {"type": "string"}, "from": {"type": "string"}, "error": {"type": "string"}, "at": {"type": "string"}}}}},
      "QuitInfo": {"type": "object", "required": ["installed", "active_jobs"], "properties": {"installed": {"type": "boolean"}, "active_jobs": {"type": "integer", "minimum": 0}}},
      "QuitResult": {"type": "object", "required": ["installed", "active_jobs", "stopped"], "properties": {"installed": {"type": "boolean"}, "active_jobs": {"type": "integer"}, "stopped": {"type": "boolean"}}},
      "Rule": {"type": "object", "required": ["id", "source", "replacement"], "additionalProperties": false,
        "properties": {"id": {"$ref": "#/components/schemas/Uuid"}, "source": {"type": "string", "minLength": 1}, "replacement": {"type": "string"}}},
      "Rules": {"type": "object", "required": ["rules", "locked"], "properties": {"rules": {"type": "array", "items": {"$ref": "#/components/schemas/Rule"}}, "locked": {"type": "boolean"}}},
      "VideoClip": {"type": "object", "required": ["path", "name"], "properties": {"path": {"type": "string"}, "name": {"type": "string"},
        "error": {"enum": ["VIDEO_MISSING", "VIDEO_UNREADABLE", "VIDEO_TYPE", "VIDEO_INVALID"]}, "size": {"type": "integer"}, "mtime": {"type": "integer"},
        "duration_ms": {"type": "integer"}, "width": {"type": "integer"}, "height": {"type": "integer"}, "fps": {"type": "number"}, "codec": {"type": "string"},
        "pix_fmt": {"type": "string"}, "rotation": {"type": "integer"}, "bitrate": {"type": "integer"}}},
      "VideoFiles": {"type": "object", "required": ["files"], "properties": {"files": {"type": "array", "items": {"$ref": "#/components/schemas/VideoClip"}}}},
      "VideoEstimate": {"type": "object", "required": ["files"], "properties": {"files": {"type": "array", "items": {"$ref": "#/components/schemas/VideoClip"}},
        "error": {"type": "string"}, "resolutions": {"type": "array", "items": {"enum": ["keep", "1080", "720", "480"]}}, "resolution": {"type": "string"}, "quality": {"type": "string"},
        "plan": {"type": "object"}, "free_bytes": {"type": "integer"}, "needed_bytes": {"type": ["integer", "null"]}, "enough": {"type": ["boolean", "null"]}}},
      "TranslationMemory": {"type": "object", "required": ["start_free_gib", "default_gib", "min_gib", "max_gib", "step_gib", "customised", "available_gib", "total_gib"], "properties": {
        "start_free_gib": {"type": "number"}, "default_gib": {"type": "number"}, "min_gib": {"type": "number"}, "max_gib": {"type": "number"}, "step_gib": {"type": "number"},
        "customised": {"type": "boolean"}, "available_gib": {"type": "number"}, "total_gib": {"type": "number"}}},
      "ComputeSettings": {"type": "object", "required": ["device", "capabilities"],
        "properties": {"device": {"enum": ["cpu", "gpu"]}, "capabilities": {"type": "object", "required": ["transcription", "translation", "tts"],
          "properties": {"transcription": {"type": "boolean"}, "translation": {"type": "boolean"}, "tts": {"type": "boolean"}, "gpu_name": {"type": ["string", "null"]}}}}},
      "YoutubeStatus": {"type": "object", "required": ["enabled", "state"], "properties": {"enabled": {"type": "boolean"}, "state": {"type": "string"}, "browser_available": {"type": "boolean"}, "downloader": {"type": "object"}}},
      "Voice": {"type": "object", "required": ["id", "label", "description", "preview_url"],
        "properties": {"id": {"type": "string"}, "label": {"type": "string"}, "description": {"type": "string"}, "aliases": {"type": "array"}, "preview_url": {"type": ["string", "null"], "pattern": "^/api/voices/preview/[a-f0-9]{64}$"}}},
      "Voices": {"type": "object", "required": ["voices", "default_voice_id", "selected_voice_id", "styles", "selected_style", "address_profiles", "preview_status"],
        "properties": {"voices": {"type": "array", "items": {"$ref": "#/components/schemas/Voice"}}, "default_voice_id": {"type": "string"}, "selected_voice_id": {"type": "string"},
          "styles": {"type": "array", "items": {"type": "object", "required": ["id"]}}, "selected_style": {"type": "string"},
          "address_profiles": {"type": "array", "items": {"type": "string"}}, "preview_status": {"type": "string"}}}
    }
  }
}
